{
    "compilerOptions": {
        "module": "esnext",
        "lib": [
            "ESNext",
            "dom"
        ],
        "declaration": false,   // true if you want d.ts files for your constructions
        "outDir": "dist",
        "strict": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "inlineSourceMap": true,
        "allowJs": true,
    },
    "include": [
        "src/**/*"
    ],
    "watchOptions": {
        "excludeFiles": ["dist/**/*"]
    }
}